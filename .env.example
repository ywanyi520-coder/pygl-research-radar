# Copy variable names into GitHub Actions Secrets or a local environment.
# Never commit values to this repository.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RADAR_TRIAGE_MODEL=gpt-4o-mini
RADAR_REVIEW_MODEL=gpt-4o-mini
UNPAYWALL_EMAIL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OPEN_ID=
WECHAT_TEMPLATE_ID=
# Optional test-account/API endpoint override for integration testing only.
WECHAT_API_BASE_URL=https://api.weixin.qq.com
# Production GitHub Actions supplies these automatically; local runs can use a fine-grained token.
GITHUB_TOKEN=
GITHUB_REPOSITORY=ywanyi520-coder/pygl-research-radar
GITHUB_API_URL=https://api.github.com
# Optional public Pages base URL. Leave blank to derive the project Pages URL
# from GITHUB_REPOSITORY in GitHub Actions; set a custom domain later here.
PUBLIC_SITE_URL=
# Optional custom-domain CNAME, e.g. radar.example.com (never a secret).
CUSTOM_DOMAIN=
